{
  "mcpServers": {
    "example_stdio": {
      "transport": "stdio",
      "command": "python",
      "args": ["path/to/your_mcp_server.py"]
    },
    "example_streamable_http": {
      "transport": "streamable_http",
      "url": "http://localhost:8000/mcp",
      "headers": {
        "Authorization": "Bearer <your-token>"
      }
    }
  }
}
